# ProjectPilot Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
# For SQLite local dev:
DATABASE_URL=sqlite:///./projectpilot.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql://projectpilot:projectpilot@localhost:5432/projectpilot_db

# Security & Authentication
SECRET_KEY=projectpilot-dev-insecure-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Proposal Generator (Provider-Agnostic)
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=default
